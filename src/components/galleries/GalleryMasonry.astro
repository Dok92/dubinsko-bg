---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface GalleryImage {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  images: GalleryImage[];
  title: string;
  description: string;
  id?: string;
  as?: 'h1' | 'h2';
  moreHref?: string;
  moreLabel?: string;
}

const { images, title, description, id = 'galerija', as: Tag = 'h2', moreHref, moreLabel = 'Pogledaj sve slike' } = Astro.props;
---

<section class='gallery' id={id}>
  <div class='gallery-headline'>
    <Tag class='gallery-title'>{title}</Tag>
    <p class='gallery-desc'>{description}</p>
  </div>

  <div class='gallery-masonry'>
    {
      images.map((img, i) => (
        <div class='gallery-item' data-ar={(img.src.width / img.src.height).toFixed(4)} style={`--ar:${img.src.width / img.src.height};--i:${i % 8}`}>
          <Image
            src={img.src}
            alt={img.alt}
            widths={[320, 480, 640]}
            sizes='(max-width: 48rem) 48vw, (max-width: 72rem) 25vw, 17rem'
            loading='lazy'
            decoding='async'
          />
        </div>
      ))
    }
  </div>

  {
    moreHref && (
      <div class='gallery-more'>
        <a class='gallery-btn' href={moreHref}>
          {moreLabel} <span aria-hidden='true'>→</span>
        </a>
      </div>
    )
  }
</section>

<style>
  .gallery {
    max-width: calc(var(--max, 72rem) + 2 * var(--pad, 1rem));
    margin-inline: auto;
    padding: clamp(3rem, 7vw, 6rem) var(--pad, 1rem);
  }

  .gallery-headline {
    display: grid;
    gap: 0.7rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  .gallery-title {
    margin: 0;
    max-width: 20ch;
    font-family: var(--serif, Georgia, serif);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3.1rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--ink, #2a2620);
    text-wrap: balance;
  }
  .gallery-desc {
    margin: 0;
    max-width: 56ch;
    color: var(--muted, #6c6355);
    font-size: 1.1rem;
  }

  .gallery-masonry {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    align-items: start;
    width: 100%;
  }
  .gallery-masonry.is-masonry {
    grid-auto-rows: 4px;
    row-gap: 0;
    column-gap: 0.65rem;
  }

  .gallery-item {
    align-self: start;
    width: 100%;
    aspect-ratio: var(--ar);
    overflow: hidden;
    border-radius: var(--r, 1.25rem);
    border: 1px solid var(--line, #ddd4c3);
    background: var(--bg-2, #ebe3d4);
  }
  .is-masonry .gallery-item { margin-bottom: 0.65rem; }

  .gallery-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease, ease);
  }
  .gallery-item:hover img { transform: scale(1.05); }

  .gallery-more { display: flex; justify-content: center; margin-top: 1.75rem; }
  .gallery-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.6rem;
    border-radius: 999px;
    background: var(--blue, #4a77b4);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.25s, transform 0.3s var(--ease, ease);
  }
  .gallery-btn:hover { background: var(--blue-d, #36598f); transform: translateY(-2px); }
  .gallery-btn span { transition: transform 0.3s var(--ease, ease); }
  .gallery-btn:hover span { transform: translateX(4px); }

  @media (min-width: 48rem) {
    .gallery-masonry { grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); gap: 1rem; }
    .gallery-masonry.is-masonry { column-gap: 1rem; }
    .is-masonry .gallery-item { margin-bottom: 1rem; }
  }

  .gallery.is-armed .gallery-headline > *,
  .gallery.is-armed .gallery-item,
  .gallery.is-armed .gallery-more {
    opacity: 0;
    transform: translateY(1.25rem);
    transition: opacity 0.8s var(--ease, ease), transform 0.8s var(--ease, ease);
  }
  .gallery.is-armed .gallery-item { transition-delay: calc(var(--i) * 60ms); }
  .gallery.is-armed .gallery-headline > :nth-child(2) { transition-delay: 90ms; }
  .gallery.is-armed.is-in .gallery-headline > *,
  .gallery.is-armed.is-in .gallery-item,
  .gallery.is-armed.is-in .gallery-more { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .gallery .gallery-headline > *, .gallery .gallery-item, .gallery .gallery-more { opacity: 1 !important; transform: none !important; transition: none !important; }
    .gallery-item img { transition: none; }
  }
</style>

<script>
  const ROW = 4;

  function layout(grid: HTMLElement) {
    const cs = getComputedStyle(grid);
    const gap = parseFloat(cs.columnGap) || 0;
    const items = Array.from(grid.children) as HTMLElement[];

    const spans = items.map((item) => {
      const ar = Number(item.dataset.ar) || 1;
      const h = item.clientWidth / ar;
      return Math.ceil((h + gap) / ROW);
    });

    items.forEach((item, i) => {
      const v = `span ${spans[i]}`;
      if (item.style.gridRowEnd !== v) item.style.gridRowEnd = v;
    });
  }

  document.querySelectorAll<HTMLElement>('.gallery').forEach((root) => {
    root.classList.add('is-armed');
    new IntersectionObserver(([en], obs) => {
      if (!en.isIntersecting) return;
      root.classList.add('is-in');
      obs.disconnect();
    }, { threshold: 0, rootMargin: '0px 0px -5% 0px' }).observe(root);

    const grid = root.querySelector<HTMLElement>('.gallery-masonry');
    if (!grid) return;
    grid.classList.add('is-masonry');

    let raf = 0;
    new ResizeObserver(() => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => layout(grid));
    }).observe(grid);
  });
</script>