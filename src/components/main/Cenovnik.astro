---
// Unified price list shared by every page.
// Per-page props: pricingHeading (HTML allowed, e.g. <em>), pricingParagraph (optional), pricingNote (optional).
const { pricingHeading, pricingParagraph, pricingNote } = Astro.props;

const groups = [
  {
    id: 'namestaj',
    title: 'Dubinsko pranje nameštaja',
    rows: [
      ['Trosed', '2000 din.'],
      ['Dvosed', '1400 din.'],
      ['Fotelja', '1000 din.'],
      ['Stolica', '300 din.'],
      ['Bračni krevet', '2000 din.'],
      ['Ugaona garnitura', '700 din. po sednom mestu'],
      ['Singl dušek (jednostrano / obostrano)', '1200 / 1600 din.'],
      ['Bračni dušek (jednostrano / obostrano)', '1600 / 2000 din.'],
    ],
  },
  {
    id: 'tepisi',
    title: 'Dubinsko pranje tepiha, staza i itisona',
    rows: [
      ['Tepih', '250 din./m²'],
      ['Staza', '250 din./m²'],
      ['Itison', '250 din./m²'],
      ['Mašinsko pranje čvrstih podova i pločica ', '250 din./m²'],
    ],
  },
  {
    id: 'vozila',
    title: 'Dubinsko pranje automobila (prema veličini vozila)',
    rows: [
      ['Smart, Yugo…', '4000 din.'],
      ['Renault Clio, Fiat Punto…', '5000 din.'],
      ['Peugeot 307, VW Golf…', '5500 din.'],
      ['Škoda Superb, Audi A6…', '6500 din.'],
      ['SUV', '7500 din.'],
      ['Doplata za karavan', '+ 500 din.'],
    ],
  },
];

const discounts = [
  ['10%', 'popusta za pranje od 6000 do 7999 din.'],
  ['15%', 'popusta za pranje od 8000 din.'],
  ['10%', 'popusta za trudnice i starije sugrađane'],
];
---

<section class='section section--tint' id='cenovnik'>
  <div class='section__head reveal'>
    <h2 set:html={pricingHeading} />
    {pricingParagraph && <p>{pricingParagraph}</p>}
  </div>
  <div class='pricing'>
    <div class='pgroups'>
      {
        groups.map((g) => (
          <div class='pgroup reveal' id={`cenovnik-${g.id}`}>
            <h3>{g.title}</h3>
            <dl class='plist'>
              {g.rows.map(([n, p]) => (
                <div class='plist__row'>
                  <dt>{n}</dt>
                  <dd>{p}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))
      }
    </div>
    <div class='discounts' data-stagger>
      {
        discounts.map(([pct, text]) => (
          <div class='disc reveal'>
            <b>{pct}</b>
            <span>{text}</span>
          </div>
        ))
      }
    </div>
  </div>
  {pricingNote && <p class='note reveal'>{pricingNote}</p>}
</section>

<style>
  .pricing { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr); gap: 1.25rem; align-items: start; max-width: var(--max); margin-inline: auto; }
  .pgroups { display: grid; gap: 1.75rem; }
  .pgroup h3 { margin-bottom: 0.75rem; font-size: 1.3rem; line-height: 1.25; }

  .plist { background: var(--card); border: 1px solid var(--card-line); border-radius: var(--r); padding: 0.5rem 1.5rem; }
  .plist__row { display: flex; justify-content: space-between; gap: 1rem; padding: 0.9rem 0; }
  .plist__row + .plist__row { border-top: 1px solid var(--line); }
  .plist dd { font-weight: 700; color: var(--blue-d); text-align: right; white-space: nowrap; }

  .discounts { display: grid; gap: 1rem; }
  .disc { display: flex; align-items: center; gap: 1rem; padding: 1.25rem 1.5rem; background: linear-gradient(140deg, #e6f2fd, #d3e7f9); border: 1px solid #b9d7f2; border-radius: var(--r); }
  .disc b { font-family: var(--serif); font-weight: 400; font-size: 2.3rem; line-height: 1; color: var(--blue-d); }

  @media (min-width: 60.01rem) {
    .discounts { position: sticky; top: 6rem; }
  }

  /* Tablet and below: one column */
  @media (max-width: 60rem) {
    .pricing { grid-template-columns: minmax(0, 1fr); }
  }

  /* Phone: label left, price right; the price drops to its own line only when it does not fit */
  @media (max-width: 40rem) {
    .pgroups { gap: 1.25rem; }
    .pgroup h3 { font-size: 1.15rem; }
    .plist { padding: 0.25rem 1rem; }
    .plist__row { flex-wrap: wrap; gap: 0.15rem 0.75rem; padding: 0.8rem 0; }
    .plist dt { flex: 1 1 10.5rem; min-width: 0; }
    .plist dd { flex: 0 0 auto; margin-left: auto; white-space: normal; text-align: right; }
    .disc { gap: 0.85rem; padding: 1rem 1.1rem; }
    .disc b { flex: none; min-width: 3.4rem; font-size: 1.9rem; }
  }
</style>