---
const { pricingHeading } = Astro.props
const { pricingParagraph } = Astro.props

const prices = [
  ['Automobil', 'od 4000 din.'], ['Trosed', '2000 din.'], ['Bračni krevet', '2000 din.'],
  ['Dvosed', '1400 din.'], ['Fotelja', '1000 din.'], ['Stolica', '300 din.'],
  ['Ugaona garnitura', '700 din. po sednom mestu'], ['Tepih / staza / itison', '250 din./m²'],
  ['Singl dušek (jednostrano / obostrano)', '1200 / 1600 din.'], ['Bračni dušek (jednostrano / obostrano)', '1600 / 2000 din.'],
];
---

  <section class='section section--tint' id='cenovnik'>
    <div class='section__head reveal'>
      <h2>{pricingHeading}</h2>
      <p>{pricingParagraph}</p>
    </div>
    <div class='pricing'>
      <dl class='plist reveal'>
        {prices.map(([n, p]) => <div class='plist__row'><dt>{n}</dt><dd>{p}</dd></div>)}
      </dl>
      <div class='discounts' data-stagger>
        <div class='disc reveal'><b>10%</b><span>popusta za pranje od 6000 do 7999 din.</span></div>
        <div class='disc reveal'><b>15%</b><span>popusta za pranje od 8000 din.</span></div>
        <div class='disc reveal'><b>10%</b><span>popusta za trudnice i starije sugrađane</span></div>
      </div>
    </div>
  </section>