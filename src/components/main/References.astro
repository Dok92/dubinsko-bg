<style>
  .refs {
    padding: clamp(3rem, 7vw, 5.5rem) 0;
    background: var(--bg-2, #ebe3d4);
    overflow: hidden;
  }
  .refs__head {
    display: grid;
    gap: 0.9rem;
    max-width: var(--max, 72rem);
    margin: 0 auto clamp(1.5rem, 4vw, 2.5rem);
  }
  .refs h2 {
    max-width: 22ch;
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 3rem);
    line-height: 1.12;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .refs h2 em { font-style: italic; color: var(--blue, #4a77b4); }
  .refs__head p { margin: 0; max-width: 60ch; color: var(--muted, #6c6355); font-size: 1.08rem; }
  .refs__stats { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.4rem 0 0; padding: 0; list-style: none; }
  .refs__stats li {
    padding: 0.4rem 1rem;
    border-radius: 999px;
    background: var(--blue-soft, #e1eaf6);
    color: var(--blue-d, #36598f);
    font-size: 0.95rem;
  }
  .refs__stats b { font-weight: 700; }

  .rows { display: grid; gap: 0.65rem; }
  .row {
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .row::-webkit-scrollbar { display: none; }
  .track { display: flex; width: max-content; margin: 0; padding: 0; list-style: none; }
  .track li {
    flex: none;
    margin-right: 0.65rem;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    background: var(--card, #fbf8f2);
    border: 1px solid var(--line, #ddd4c3);
    color: var(--ink, #2a2620);
    font-size: 0.95rem;
    white-space: nowrap;
    transition: border-color 0.25s, color 0.25s;
  }
  .track li.key {
    font-family: var(--serif, Georgia, serif);
    font-style: italic;
    font-size: 1.1rem;
    border-color: #b8c9e3;
    color: var(--blue-d, #36598f);
  }
  .track li:hover { border-color: var(--blue, #4a77b4); }

  .row.is-live { overflow: hidden; }
  .row.is-live .track {
    animation: refs-slide var(--t, 120s) linear infinite;
    will-change: transform;
  }
  .row.is-live[data-rev='1'] .track { animation-direction: reverse; }
  .row.is-live:hover .track,
  .refs.is-paused .track { animation-play-state: paused; }
  @keyframes refs-slide { to { transform: translateX(-50%); } }

  /* Ulazna animacija zaglavlja */
  @media (scripting: enabled) {
    .refs__head > * { opacity: 0; transform: translateY(1.25rem); transition: opacity 0.9s var(--ease, ease), transform 0.9s var(--ease, ease); }
    .refs__head > :nth-child(2) { transition-delay: 90ms; }
    .refs__head > :nth-child(3) { transition-delay: 180ms; }
    .refs.is-in .refs__head > * { opacity: 1; transform: none; }
    .rows { opacity: 0; transition: opacity 1.1s 0.25s; }
    .refs.is-in .rows { opacity: 1; }
  }

  @media (max-width: 40rem) {
    .track li { padding: 0.4rem 0.9rem; font-size: 0.88rem; }
    .track li.key { font-size: 1rem; }
    .rows { gap: 0.5rem; }

    .refs__head {
      padding: 0 var(--pad);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .refs__head > *, .rows { opacity: 1 !important; transform: none !important; transition: none !important; }
    .row.is-live .track { animation: none; }
  }
</style>

<script>
  const section = document.getElementById('reference');
  const rows = document.querySelectorAll<HTMLElement>('#refsRows .row');

  if (section) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduce) {
      rows.forEach((row) => {
        const track = row.firstElementChild as HTMLElement | null;
        if (!track) return;
        const frag = document.createDocumentFragment();
        for (const li of Array.from(track.children)) {
          const c = li.cloneNode(true) as HTMLElement;
          c.setAttribute('aria-hidden', 'true');
          frag.appendChild(c);
        }
        track.appendChild(frag);
        row.classList.add('is-live');
      });
    }

    new IntersectionObserver(([e]) => {
      section.classList.toggle('is-paused', !e.isIntersecting);
      if (e.isIntersecting) section.classList.add('is-in');
    }, { threshold: 0.1 }).observe(section);
  }
</script>
