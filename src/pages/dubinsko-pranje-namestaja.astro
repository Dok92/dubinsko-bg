---
import Layout from '../layouts/Layout.astro';
import imgBefore from '../assets/furniture-before.jpg';
import imgAfter from '../assets/furniture-after.jpg';
import Faq from '../components/accordions/faq.astro';
import Footer from '../components/main/Footer.astro';
import References from '../components/main/References.astro';
import Pricing from '../components/main/Cenovnik.astro';

const path = '/dubinsko-pranje-namestaja';
const origin = Astro.site?.origin ?? '';

const steps = [
  [
    'Naprskavanje',
    'Rastvor vode i profesionalnog Karcher praška nanosimo na tapaciranu površinu garniture, fotelje, stolice ili dušeka.',
  ],
  [
    'Četkanje',
    'Površinu pažljivo izčetkamo kako bi se prljavština, znoj i masnoća odvojili od tkanine, a da se materijal pritom ne ošteti.',
  ],
  [
    'Usisavanje',
    'Profesionalnom mašinom izvlačimo vodu i nečistoću do dubine od 10 cm. Postupak ponavljamo dok ne bude čisto.',
  ],
];

const prices = [
  ['Tepih / staza / itison', '250 din./m²'],
  ['Automobil', 'od 4000 din.'],
  ['Trosed', '2000 din.'],
  ['Bračni krevet', '2000 din.'],
  ['Dvosed', '1400 din.'],
  ['Fotelja', '1000 din.'],
  ['Stolica', '300 din.'],
  ['Ugaona garnitura', '700 din. po sednom mestu'],
  ['Singl dušek (jednostrano / obostrano)', '1200 / 1600 din.'],
  ['Bračni dušek (jednostrano / obostrano)', '1600 / 2000 din.'],
];

const faq = [
  [
    'Koliko košta dubinsko pranje nameštaja?',
    'Cena zavisi od komada nameštaja: trosed 2000 din., dvosed 1400 din., fotelja 1000 din., stolica 300 din., bračni krevet 2000 din. Ugaona garnitura se računa 700 din. po sednom mestu. Za veća pranja važe popusti od 10% i 15%.',
  ],
  [
    'Da li nameštaj nosite kod sebe?',
    'Ne. Nameštaj ne nosimo, već ga peremo isključivo kod Vas na adresi. Mašine donosimo u Vaš stan, kuću ili poslovni prostor, pa nameštaj ne morate nigde da selite.',
  ],
  [
    'Koliko košta pranje dušeka?',
    'Dušeke peremo jednostrano ili obostrano. Singl dušek košta 1200 din. za jednu stranu i 1600 din. za obe, a bračni 1600 din. za jednu stranu i 2000 din. za obe strane.',
  ],
  [
    'Koje mašine i sredstva koristite?',
    'Koristimo profesionalne Karcher mašine i Karcher prašak bez dugotrajnog mirisa, potpuno neškodljiv po ljude i životinje. Zato su garniture i dušeci bezbedni za decu i kućne ljubimce čim se osuše.',
  ],
  [
    'Do koje dubine usisavate nečistoću iz nameštaja?',
    'Do dubine od 10 cm. Kombinacijom mašina i hemije uklanjamo prašinu, neprijatne mirise, grinje i mikroorganizme iz mebla, koje običan usisivač ne može da dohvati.',
  ],
  [
    'Da li možete garantovati da će se sve fleke oprati?',
    'Većinu fleka operemo bez problema, ali ne možemo garantovati uklanjanje apsolutno svih. Najkritičnije su fleke od urina, krvi i motornog ulja. Garantujemo da će se tehničari maksimalno potruditi, a eventualne reklamacije prihvatamo.',
  ],
  [
    'Da li pranje može da ošteti nameštaj?',
    'Isti proces primenjujemo godinama. Ako je mebl već oštećen ili dotrajao, tehničar će Vas upozoriti i ta mesta tretirati blaže. Zidovi, parket i laminat se ne oštećuju.',
  ],
  [
    'Koliko traje sušenje nameštaja posle pranja?',
    'Posle pranja ostaje oko 20% vlage. Pri spoljnoj temperaturi preko 20 stepeni sušenje traje do nekoliko sati, a zimi do 24 h. Utiču i uslovi u Vašem domu ili prostoru.',
  ],
  [
    'Da li je dolazak besplatan?',
    'Dolazak ne naplaćujemo na teritoriji Beograda i okolnih bližih opština, uz uslov da pranje vredi više od 1000 din. Radimo i u Pančevu, Novom Sadu i Zrenjaninu.',
  ],
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Dubinsko pranje nameštaja u Beogradu',
      serviceType: 'Dubinsko čišćenje nameštaja i dušeka',
      description:
        'Dubinsko pranje nameštaja na adresi klijenta profesionalnom Karcher opremom: trosedi, dvosedi, fotelje, stolice, kreveti i dušeci.',
      provider: { '@type': 'LocalBusiness', name: 'IV PRANJE 2020', telephone: '+381652389201' },
      areaServed: ['Beograd', 'Pančevo', 'Novi Sad', 'Zrenjanin'].map(
        (n) => ({ '@type': 'City', name: n }),
      ),
      offers: [
        ['Trosed', 2000],
        ['Dvosed', 1400],
        ['Fotelja', 1000],
        ['Stolica', 300],
        ['Bračni krevet', 2000],
      ].map(([name, price]) => ({ '@type': 'Offer', name, price, priceCurrency: 'RSD' })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map(([q, a]) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Dubinsko pranje Beograd', item: `${origin}/` },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Dubinsko pranje nameštaja',
          item: `${origin}${path}`,
        },
      ],
    },
  ],
};
---

<Layout
  title='Dubinsko pranje nameštaja Beograd cena od 300 din po komadu'
  ogTitle='Dubinsko pranje nameštaja Beograd | IV PRANJE 2020'
  metaDescription='Dubinsko čišćenje nameštaja u Beogradu na Vašoj adresi: dubinsko pranje troseda, fotelja, stolica, kreveta, dušeka i dr. Karcher oprema, dolazak besplatan'
  canonical=`https://dubinskopranjebeograd.com${path}`
>
  <script type='application/ld+json' set:html={JSON.stringify(schema)} />

  <section class='hero'>
    <div class='hero__copy'>
      <nav class='crumbs' aria-label='Putanja' data-in style='--i:0'>
        <a href='/'>Dubinsko pranje Beograd</a><span aria-hidden='true'>/</span><span
          aria-current='page'>Dubinsko pranje nameštaja</span
        >
      </nav>
      <h1 data-in style='--i:1'>
        Dubinsko pranje nameštaja u Beogradu, <em>bez nošenja</em> nameštaja.
      </h1>
      <p class='lead' data-in style='--i:2'>
        Dubinsko čišćenje troseda, fotelja, stolica, kreveta i dušeka kod Vas na adresi,
        profesionalnom Karcher opremom. Cenu znate unapred, a preko 30.000 klijenata u 15 godina
        poslovanja potvrđuje iskustvo.
      </p>
      <div class='actions' data-in style='--i:3'>
        <a class='pill pill--solid pill--lg' href='tel:0652389201'>Zakaži pranje nameštaja</a>
        <a class='pill pill--line pill--lg' href='#cenovnik'>Pogledaj cene</a>
      </div>
      <ul class='facts' data-in style='--i:4'>
        <li>Trosed 2000 din., dvosed 1400 din., fotelja 1000 din.</li>
        <li>Dolazak besplatan u Beogradu i okolini</li>
        <li>Prihvatamo sve eventualne reklamacije</li>
      </ul>
    </div>

    <figure class='ba' id='ba' style='--pos:50%;--i:2' data-in>
      <div class='ba__frame'>
        <img
          class='ba__img'
          src={imgBefore.src}
          width={imgBefore.width}
          height={imgBefore.height}
          alt='Nameštaj pre dubinskog pranja'
          fetchpriority='high'
          decoding='async'
        />
        <img
          class='ba__img ba__img--after'
          src={imgAfter.src}
          width={imgAfter.width}
          height={imgAfter.height}
          alt='Isti nameštaj posle dubinskog pranja u Beogradu'
          fetchpriority='high'
          decoding='async'
        />
        <span class='ba__line' aria-hidden='true'></span>
        <span class='ba__knob' aria-hidden='true'></span>
        <input
          class='ba__range'
          id='baRange'
          type='range'
          min='0'
          max='100'
          step='0.1'
          value='50'
          aria-label='Uporedi nameštaj pre i posle pranja'
        />
        <span class='pill pill--tag ba__tag ba__tag--l'>Pre</span>
        <span class='pill pill--tag ba__tag ba__tag--r'>Posle</span>
      </div>
      <figcaption>Stvarni rezultat sa terena. Povucite da uporedite.</figcaption>
    </figure>
  </section>

  <section class='stats' aria-label='Naše iskustvo u brojkama'>
    <div class='stats__in' data-stagger>
      <div class='stat reveal'>
        <b data-count='30000' data-suffix='+'>30.000+</b><span>zadovoljnih klijenata</span>
      </div>
      <div class='stat reveal'><b data-count='15'>15</b><span>godina poslovanja</span></div>
      <div class='stat reveal'>
        <b data-count='300' data-suffix=' din'>300 din</b><span>cena pranja stolice</span>
      </div>
      <div class='stat reveal'>
        <b data-count='10' data-suffix=' cm'>10 cm</b><span>dubina usisavanja nečistoće</span>
      </div>
    </div>
  </section>

  <section class='section' id='sta-je'>
    <div class='section__head reveal'>
      <h2>Šta je dubinsko čišćenje nameštaja</h2>
      <p>
        Dubinsko pranje nameštaja je mašinski postupak koji izvlači prljavštinu iz tkanine i ispune,
        a ne samo sa površine. Zato se razlika vidi, ali i oseća.
      </p>
    </div>
    <div class='subs' data-stagger>
      <article class='sub reveal'>
        <h3>Više od usisavanja i krpe</h3><p>
          Usisivač i vlažna krpa čiste samo površinu. U dubini ostaju znoj, masnoća, prašina, grinje
          i mikroorganizmi. Dubinsko čišćenje izvlači ih do 10 cm dubine, tamo gde se zadržava
          najviše nečistoće.
        </p>
      </article>
      <article class='sub reveal'>
        <h3>Čišćenje kod Vas, bez selidbe</h3><p>
          Nameštaj ne nosimo, već ga peremo isključivo kod Vas. Mašine donosimo na Vašu adresu, pa
          garnitura ostaje u prostoriji u kojoj je svakodnevno koristite.
        </p>
      </article>
      <article class='sub reveal'>
        <h3>Za svaki komad u domu</h3><p>
          Dubinsko pranje nameštaja obuhvata trosede, dvosede, ugaone garniture, fotelje, stolice,
          krevete i dušeke. Isti postupak koristimo na svim tapaciranim površinama.
        </p>
      </article>
      <article class='sub reveal'>
        <h3>Uklanja neprijatne mirise</h3><p>
          Mirisi se zadržavaju duboko u ispuni. Kombinacijom mašine i hemije uklanjamo ih zajedno sa
          nečistoćom, umesto da ih samo prekrijemo osveživačem.
        </p>
      </article>
    </div>
  </section>

  <References />
    <Pricing
    pricingHeading='Dubinsko pranje nameštaja: cena po komadu'
    pricingParagraph='Cena dubinskog pranja nameštaja zavisi od komada, pa tačno znate koliko ćete platiti pre nego što tehničar počne sa radom.'
    pricingNote='Primer obračuna: trosed (2000 din.) i dve fotelje (2 x 1000 din.) koštaju ukupno 4000 din. Ugaona garnitura sa pet sednih mesta košta 5 x 700 = 3500 din.'
  />

  <section class='section section--tint' id='postupak'>
    <div class='section__head reveal'>
      <h2>Kako peremo nameštaj u tri koraka</h2>
      <p>
        Isti postupak primenjujemo godinama. Ponavlja se sve dok tehničar ne utvrdi da je površina
        čista.
      </p>
    </div>
    <ol class='steps' data-stagger>
      {
        steps.map(([t, p], i) => (
          <li class='step reveal'>
            <span class='step__n'>{i + 1}</span>
            <h3>{t}</h3>
            <p>{p}</p>
          </li>
        ))
      }
    </ol>
    <h3 class='subhead reveal'>Prednosti dubinskog pranja nameštaja</h3>
    <div class='subs' data-stagger>
      <article class='sub reveal'>
        <h3>Čisto do dubine</h3><p>
          Prljavština se uklanja iz celog sloja tkanine i ispune. Garnitura izgleda svežije, a boja
          se vraća tamo gde je prljavština bila najvidljivija.
        </p>
      </article>
      <article class='sub reveal'>
        <h3>Bez dugotrajnog mirisa</h3><p>
          Karcher prašak koji koristimo nema dugotrajan miris, pa prostorija ne miriše na hemiju
          nakon pranja.
        </p>
      </article>
      <article class='sub reveal'>
        <h3>Bezbedno za porodicu</h3><p>
          Sredstva su neškodljiva po ljude i životinje, pa se deca i kućni ljubimci vraćaju čistoj
          garnituri čim se osuši.
        </p>
      </article>
      <article class='sub reveal'>
        <h3>Poznata cena unapred</h3><p>
          Plaćate samo ono što perete, a za veća pranja važe popusti od 10% i 15%.
        </p>
      </article>
    </div>
  </section>

  <section class='section section--tint' id='dusek'>
    <div class='section__head reveal'>
      <h2>Dubinsko pranje dušeka i kreveta</h2>
      <p>
        Dušeci i kreveti skupljaju znoj, prašinu i grinje iz noći u noć. Dubinsko čišćenje uklanja
        ih iz ispune, što je posebno važno za alergičare i decu.
      </p>
    </div>
    <div class='subs' data-stagger>
      <article class='sub reveal'>
        <h3>Singl dušek</h3><p>
          Dušek peremo jednostrano za <b>1200 din.</b> ili obostrano za <b>1600 din.</b> Birate varijantu
          koja Vam odgovara.
        </p>
      </article>
      <article class='sub reveal'>
        <h3>Bračni dušek</h3><p>
          Jednostrano pranje bračnog dušeka košta <b>1600 din.</b>, a obostrano <b>2000 din.</b> Dušek
          se pere na licu mesta, bez skidanja sa kreveta.
        </p>
      </article>
      <article class='sub reveal'>
        <h3>Bračni krevet</h3><p>
          Dubinsko pranje bračnog kreveta košta <b>2000 din.</b> Uklanja fleke, neprijatne mirise, grinje
          i mikroorganizme iz tapaciranih delova.
        </p>
      </article>
    </div>
  </section>

  <section class='section' id='fleke'>
    <div class='section__head reveal'>
      <h2>Fleke, mirisi i grinje: šta pranje uklanja</h2>
      <p>
        Iskreno o rezultatima: većinu fleka skidamo bez problema, ali ne možemo da garantujemo
        uklanjanje apsolutno svih.
      </p>
    </div>
    <div class='subs' data-stagger>
      <article class='sub reveal'>
        <h3>Uobičajene fleke</h3><p>
          Fleke od hrane i pića, masnoće i svakodnevne prljavštine u većini slučajeva operemo bez
          problema. Što je fleka svežija, lakše se uklanja.
        </p>
      </article>
      <article class='sub reveal'>
        <h3>Teže fleke</h3><p>
          Najkritičnije su fleke od urina, krvi i motornog ulja. Njih ponekad nije moguće ukloniti u
          potpunosti. Tehničar će Vas obavestiti pre i tokom rada.
        </p>
      </article>
      <article class='sub reveal'>
        <h3>Grinje i mikroorganizmi</h3><p>
          U ispuni se godinama skupljaju grinje i mikroorganizmi. Dubinsko usisavanje do 10 cm
          uklanja ih, što je važno za domove sa alergičarima i malom decom.
        </p>
      </article>
      <article class='sub reveal'>
        <h3>Već oštećen mebl</h3><p>
          Ako je nameštaj oštećen ili dotrajao, tehničar će Vas upozoriti i ta mesta tretirati
          blaže.
        </p>
      </article>
    </div>
  </section>

  <section class='section section--tint' id='susenje'>
    <div class='split'>
      <div class='reveal'>
        <h2>Sušenje i nega nameštaja posle pranja</h2>
        <p class='body'>
          Posle dubinskog pranja ostaje oko 20% vlage. Ako je spoljna temperatura iznad 20 stepeni,
          nameštaj se suši do nekoliko sati, a zimi do 24 h. Na brzinu sušenja utiču i uslovi u
          Vašem domu ili prostoru.
        </p>
        <p class='body'>
          Preporučujemo da prostoriju provetrite kako bi se nameštaj brže osušio. Garnituru je
          najbolje ne koristiti dok se potpuno ne osuši.
        </p>
        <p class='body'>Pranje radimo pažljivo, pa se zidovi, parket i laminat ne oštećuju.</p>
      </div>
      <div class='split__side reveal'>
        <h3>Najčešće peremo</h3>
        <ul class='chips' data-stagger>
          <li class='pill pill--soft reveal'>Trosedi</li>
          <li class='pill pill--soft reveal'>Dvosedi</li>
          <li class='pill pill--soft reveal'>Ugaone garniture</li>
          <li class='pill pill--soft reveal'>Fotelje</li>
          <li class='pill pill--soft reveal'>Stolice</li>
          <li class='pill pill--soft reveal'>Kreveti</li>
          <li class='pill pill--soft reveal'>Dušeci</li>
        </ul>
      </div>
    </div>
  </section>

  <section class='section' id='lokacije'>
    <div class='section__head reveal'>
      <h2>Dubinsko pranje u Beogradu i okolini</h2>
      <p>
        Dubinsko pranje Beograd radimo na teritoriji celog grada. Dolazak je besplatan ako pranje
        vredi više od 1000 din.
      </p>
    </div>
    <div class='subs' data-stagger>
      <article class='sub reveal'>
        <h3>Dubinsko čišćenje nameštaja Beograd</h3><p>
          Dolazimo u stanove, kuće i poslovne prostore u svim beogradskim opštinama i okolnim bližim
          opštinama.
        </p>
      </article>
      <article class='sub reveal'>
        <h3>Pančevo, Novi Sad i drugi gradovi</h3><p>
          Pored Beograda, nameštaj peremo u Pančevu, Novom Sadu i Zrenjaninu.
        </p>
      </article>
      <article class='sub reveal'>
        <h3>Dogovor termina</h3><p>
          Pozovite nas, opišite komade koje želite da operete i dogovorite termin koji Vam odgovara.
        </p>
      </article>
    </div>
  </section>

  <section class='section section--tint' id='iskustvo'>
    <div class='split'>
      <div class='reveal'>
        <h2>Zašto klijenti biraju nas</h2>
        <p class='body'>
          Tokom 15 godina poslovanja naše usluge je koristilo preko 30.000 klijenata. Naši tehničari
          rade sa kućnim tapacirungom, ali i sa zahtevnim prostorima kao što su hoteli i igraonice.
        </p>
        <p class='body'>
          Koristimo najsavremenije profesionalne Karcher mašine i sredstva bez dugotrajnog mirisa.
          Prihvatamo sve eventualne reklamacije i ne obećavamo ono što ne možemo da ispunimo.
        </p>
        <div class='actions'>
          <a class='pill pill--solid pill--lg' href='tel:0652389201'>Pozovite 065 238 9201</a>
        </div>
      </div>
      <div class='split__side reveal'>
        <h3>Naše ostale usluge</h3>
        <ul class='links'>
          <li>
            <a href='/dubinsko-pranje-tepiha'>Dubinsko pranje tepiha</a><span>250 din./m²</span>
          </li>
          <li>
            <a href='/'>Dubinsko pranje Beograd: sve usluge</a><span>tepih, nameštaj, auto</span>
          </li>
        </ul>
        <p class='body' style='margin-top:0'>
          Isti tim i ista oprema rade i dubinsko pranje tepiha, staza, itisona i automobila.
        </p>
      </div>
    </div>
  </section>

  <Faq faq={faq} />
  <Footer />
</Layout>
