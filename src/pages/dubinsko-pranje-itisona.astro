---
import Layout from '../layouts/Layout.astro';
import imgBefore from '../assets/carpet-before.webp';
import imgAfter from '../assets/carpet-after.webp';
import Pricing from '../components/main/Cenovnik.astro';
import Faq from '../components/accordions/faq.astro';
import Footer from '../components/main/Footer.astro';
import References from '../components/main/References.astro';

const path = '/dubinsko-pranje-itisona';
const origin = Astro.site?.origin ?? '';

const steps = [
  ['Naprskavanje', 'Rastvor vode i profesionalnog Karcher praška ravnomerno nanosimo na celu površinu itisona, direktno na podu, bez skidanja.'],
  ['Četkanje', 'Itison pažljivo izčetkamo kako bi se prljavština, masnoća i fleke odvojile od vlakana, a da se vlakna pritom ne oštete.'],
  ['Usisavanje', 'Profesionalnom mašinom izvlačimo vodu i nečistoću do dubine od 10 cm. Postupak ponavljamo dok ne bude čisto.'],
];

const faq = [
  ['Koliko košta dubinsko pranje itisona?', 'Cena dubinskog pranja itisona je 250 din./m², ista kao za tepih i stazu. Itison od 30 m² košta 7500 din. Za veća pranja važe popusti: 10% za pranje od 6000 do 7999 din. i 15% za pranje od 8000 din., a 10% popusta imaju trudnice i stariji sugrađani.'],
  ['Kako se pere itison koji ne može da se skine sa poda?', 'Itison peremo na licu mesta, direktno na podu. Mašine donosimo na Vašu adresu, pa ništa ne morate da skidate, rolujete niti nosite. Postupak je isti kao kod tepiha: naprskavanje, četkanje i usisavanje.'],
  ['Koliko traje sušenje itisona posle pranja?', 'Posle pranja ostaje oko 20% vlage. Pri spoljnoj temperaturi preko 20 stepeni sušenje traje do nekoliko sati, a zimi do 24 h. Kod većih površina i zatvorenih prostorija preporučujemo da prostoriju provetrite.'],
  ['Da li perete itison u kancelarijama, hotelima i igraonicama?', 'Da. Pored stanova i kuća, radimo u kancelarijama, hotelima i igraonicama. Veće površine često ulaze u popust od 10% ili 15%, a termin možemo dogovoriti tako da ne ometa rad prostora.'],
  ['Koje mašine i sredstva koristite za pranje itisona?', 'Koristimo profesionalne Karcher mašine i Karcher prašak bez dugotrajnog mirisa, koji je neškodljiv po ljude i životinje. Zato je itison bezbedan za decu i kućne ljubimce čim se osuši.'],
  ['Do koje dubine usisavate nečistoću iz itisona?', 'Do dubine od 10 cm. Kombinacijom mašine i hemije uklanjamo prašinu, neprijatne mirise, grinje i mikroorganizme koje običan usisivač ne može da dohvati.'],
  ['Da li možete garantovati da će se sve fleke oprati?', 'Većinu fleka operemo bez problema, ali ne možemo garantovati uklanjanje apsolutno svih. Najkritičnije su fleke od urina, krvi i motornog ulja. Garantujemo da će se tehničari maksimalno potruditi, a eventualne reklamacije prihvatamo.'],
  ['Da li je dolazak besplatan i koje delove Beograda pokrivate?', 'Dolazak ne naplaćujemo na teritoriji Beograda i okolnih bližih opština, uz uslov da pranje vredi više od 1000 din. Radimo na Novom Beogradu, u Zemunu, na Voždovcu i u ostalim opštinama, a takođe u Pančevu, Novom Sadu, Zrenjaninu, Smederevu i Požarevcu.'],
  ['Da li je pranje itisona drugačije od pranja tepiha?', 'Postupak i cena su isti, 250 din./m². Razlika je u tome što itison obično pokriva celu prostoriju, pa se pere cela površina odjednom, bez pomeranja tepiha i bez odnošenja.'],
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Dubinsko pranje itisona u Beogradu',
      serviceType: 'Dubinsko pranje itisona',
      description: 'Dubinsko pranje itisona na licu mesta profesionalnom Karcher opremom u stanovima, kućama, kancelarijama, hotelima i igraonicama. Cena 250 din./m².',
      provider: { '@type': 'LocalBusiness', name: 'IV PRANJE 2020', telephone: '+381652389201' },
      areaServed: ['Beograd', 'Novi Beograd', 'Zemun', 'Voždovac', 'Pančevo', 'Novi Sad', 'Zrenjanin', 'Smederevo', 'Požarevac'].map((n) => ({ '@type': 'City', name: n })),
      offers: {
        '@type': 'Offer',
        priceCurrency: 'RSD',
        priceSpecification: { '@type': 'UnitPriceSpecification', price: 250, priceCurrency: 'RSD', referenceQuantity: { '@type': 'QuantitativeValue', value: 1, unitCode: 'MTK' } },
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Dubinsko pranje Beograd', item: `${origin}/` },
        { '@type': 'ListItem', position: 2, name: 'Dubinsko pranje itisona', item: `${origin}${path}` },
      ],
    },
  ],
};
---

<Layout
  title='Dubinsko pranje itisona Beograd cena 250 din/m²'
  ogTitle='Dubinsko pranje itisona Beograd'
  metaDescription='Dubinsko pranje itisona Beograd: stanovi, kancelarije, hoteli, igraonice i dr. Cena već od 250 din/m² + popusti. Više od 30.000 klijenata u 15 godina rada!'
  canonical={path}
>
  <script type='application/ld+json' set:html={JSON.stringify(schema)} />

  <section class='hero'>
      <div class='hero__copy'>
        <nav class='crumbs' aria-label='Putanja' data-in style='--i:0'>
          <a href='/'>Dubinsko pranje Beograd</a><span aria-hidden='true'>/</span><span aria-current='page'>Dubinsko pranje itisona</span>
        </nav>
        <h1 data-in style='--i:1'>Dubinsko pranje itisona u Beogradu, <em>na licu mesta</em>.</h1>
        <p class='lead' data-in style='--i:2'>
          Dubinsko pranje itisona u stanovima, kućama, kancelarijama, hotelima i igraonicama profesionalnom Karcher opremom, po ceni od 250 din./m². Preko 30.000 klijenata u 15 godina poslovanja.
        </p>
        <div class='actions' data-in style='--i:3'>
          <a class='pill pill--solid pill--lg' href='tel:0652389201'>Pozovite nas</a>
          <a class='pill pill--line pill--lg' href='#cenovnik'>Vidi cene</a>
        </div>
        <ul class='facts' data-in style='--i:4'>
          <li>Pranje itisona 250 din./m², ista cena kao za tepih i stazu</li>
          <li>Popusti od 10% i 15% za veće površine</li>
          <li>Dolazak besplatan u Beogradu i okolini</li>
        </ul>
      </div>

      <figure class='ba' id='ba' style='--pos:50%;--i:2' data-in>
        <div class='ba__frame'>
          <img class='ba__img' src={imgBefore.src} width={imgBefore.width} height={imgBefore.height} alt='Itison pre dubinskog pranja' fetchpriority='high' decoding='async' />
          <img class='ba__img ba__img--after' src={imgAfter.src} width={imgAfter.width} height={imgAfter.height} alt='Isti itison posle dubinskog pranja u Beogradu' decoding='async' />
          <span class='ba__line' aria-hidden='true'></span>
          <span class='ba__knob' aria-hidden='true'></span>
          <input class='ba__range' id='baRange' type='range' min='0' max='100' step='0.1' value='50' aria-label='Uporedi itison pre i posle pranja' />
          <span class='pill pill--tag ba__tag ba__tag--l'>Pre</span>
          <span class='pill pill--tag ba__tag ba__tag--r'>Posle</span>
        </div>
        <figcaption>Stvarni rezultat sa terena. Povucite da uporedite.</figcaption>
      </figure>
  </section>

  <section class='stats' aria-label='Naše iskustvo u brojkama'>
    <div class='stats__in' data-stagger>
      <div class='stat reveal'><b data-count='30000' data-suffix='+'>30.000+</b><span>zadovoljnih klijenata</span></div>
      <div class='stat reveal'><b data-count='15'>15</b><span>godina poslovanja</span></div>
      <div class='stat reveal'><b data-count='250' data-suffix=' din'>250 din</b><span>cena pranja po m²</span></div>
      <div class='stat reveal'><b data-count='10' data-suffix=' cm'>10 cm</b><span>dubina usisavanja nečistoće</span></div>
    </div>
  </section>

    <References />
  <Pricing
    pricingHeading='Dubinsko pranje itisona: cena po m²'
    pricingParagraph='Cena dubinskog pranja itisona zavisi od površine, pa tačno znate koliko ćete platiti pre nego što tehničar počne sa radom.'
    pricingNote='Primer obračuna: itison od 25 m² košta 25 x 250 = 6250 din., a uz popust od 10% 5625 din. Itison od 40 m² košta 10000 din., a uz popust od 15% 8500 din.'
  />

  <section class='section section--tint' id='postupak'>
    <div class='section__head reveal'>
      <h2>Kako perimo itison u tri koraka</h2>
      <p>Isti postupak primenjujemo godinama na hiljadama tepiha i itisona. Ponavlja se sve dok tehničar ne utvrdi da je površina čista.</p>
    </div>
    <ol class='steps' data-stagger>
      {steps.map(([t, p], i) => (
        <li class='step reveal'>
          <span class='step__n'>{i + 1}</span>
          <h3>{t}</h3>
          <p>{p}</p>
        </li>
      ))}
    </ol>
    <h3 class='subhead reveal'>Prednosti dubinskog pranja itisona</h3>
    <div class='subs' data-stagger>
      <article class='sub reveal'><h3>Čist do dubine</h3><p>Prljavština, prašina i fleke uklanjaju se iz celog sloja vlakana, pa itison izgleda svežije, a vlakna ostaju mekša.</p></article>
      <article class='sub reveal'><h3>Bez dugotrajnog mirisa</h3><p>Karcher prašak koji koristimo nema dugotrajan miris, pa prostorija ne miriše na hemiju nakon pranja.</p></article>
      <article class='sub reveal'><h3>Bezbedno za porodicu</h3><p>Sredstva su neškodljiva po ljude i životinje, pa se deca i kućni ljubimci vraćaju čistom itisonu čim se osuši.</p></article>
      <article class='sub reveal'><h3>Poznata cena unapred</h3><p>Cena je 250 din./m², bez skrivenih troškova, a veće površine ulaze u popuste od 10% i 15%.</p></article>
    </div>
  </section>

  <section class='section' id='prostori'>
    <div class='section__head reveal'>
      <h2>Pranje itisona u stanovima, kancelarijama i hotelima</h2>
      <p>Itison se najčešće nalazi u prostorima sa velikom površinom i puno prolaznika. Radimo u domovima i poslovnim prostorima, po istoj ceni od <b>250 din./m²</b>.</p>
    </div>
    <div class='subs' data-stagger>
      <article class='sub reveal'><h3>Stanovi i kuće</h3><p>Itison u spavaćim i dnevnim sobama skuplja prašinu, grinje i neprijatne mirise. Dubinsko pranje ih uklanja bez nošenja i bez pomeranja stvari iz celog stana.</p></article>
      <article class='sub reveal'><h3>Kancelarije</h3><p>U kancelarijama se itison prlja na prolazima i oko radnih mesta. Pranje možemo dogovoriti u terminu koji ne remeti rad zaposlenih.</p></article>
      <article class='sub reveal'><h3>Hoteli</h3><p>Radimo i u zahtevnim prostorima kao što su hoteli, gde je urednost itisona deo prvog utiska o objektu.</p></article>
      <article class='sub reveal'><h3>Igraonice</h3><p>Deca provode vreme na podu, pa je čistoća itisona posebno važna. Zato koristimo sredstva bez dugotrajnog mirisa, neškodljiva po ljude i životinje.</p></article>
    </div>
    <p class='note reveal'>Veće površine lako dostižu prag za popust: 10% važi za pranje od 6000 do 7999 din., a 15% za pranje od 8000 din. Trudnice i stariji sugrađani imaju popust od 10%.</p>
  </section>

  <section class='section section--tint' id='fleke'>
    <div class='section__head reveal'>
      <h2>Fleke, mirisi i grinje: šta pranje itisona uklanja</h2>
      <p>Iskreno o rezultatima: većinu fleka skidamo bez problema, ali ne možemo da garantujemo uklanjanje apsolutno svih.</p>
    </div>
    <div class='subs' data-stagger>
      <article class='sub reveal'><h3>Uobičajene fleke</h3><p>Fleke od hrane i pića, blata i svakodnevne prljavštine u većini slučajeva operemo bez problema. Što je fleka svežija, lakše se uklanja.</p></article>
      <article class='sub reveal'><h3>Teže fleke</h3><p>Najkritičnije su fleke od urina, krvi i motornog ulja. Njih ponekad nije moguće ukloniti u potpunosti. Tehničar će Vas obavestiti pre i tokom rada.</p></article>
      <article class='sub reveal'><h3>Grinje i mikroorganizmi</h3><p>U itisonu se godinama skupljaju grinje i mikroorganizmi. Dubinsko usisavanje do 10 cm uklanja ih iz vlakana, što je važno za domove sa malom decom i alergičarima.</p></article>
      <article class='sub reveal'><h3>Već oštećen itison</h3><p>Ako je itison oštećen ili dotrajao, tehničar će Vas upozoriti i ta mesta tretirati blaže.</p></article>
    </div>
  </section>

  <section class='section' id='susenje'>
    <div class='split'>
      <div class='reveal'>
        <h2>Sušenje i nega itisona posle pranja</h2>
        <p class='body'>
          Posle dubinskog pranja ostaje oko 20% vlage. Ako je spoljna temperatura iznad 20 stepeni, itison se suši do nekoliko sati, a zimi do 24 h. Na brzinu sušenja utiču veličina prostora i uslovi u Vašem domu ili objektu.
        </p>
        <p class='body'>
          Preporučujemo da prostoriju provetrite, a po mogućstvu uključite grejanje ili klimu kako bi se itison brže osušio. Dok se potpuno ne osuši, najbolje je izbegavati težak nameštaj i veliki saobraćaj po površini.
        </p>
        <p class='body'>
          Za redovno održavanje preporučujemo dubinsko pranje jednom do dva puta godišnje, a češće u prostorima sa mnogo prolaznika, kao što su kancelarije, hoteli i igraonice.
        </p>
      </div>
      <div class='split__side reveal'>
        <h3>Savet za duži vek itisona</h3>
        <ul class='chips' data-stagger>
          <li class='pill pill--soft reveal'>Redovno usisavanje</li>
          <li class='pill pill--soft reveal'>Pranje 1 do 2 puta godišnje</li>
          <li class='pill pill--soft reveal'>Fleke tretirati odmah</li>
          <li class='pill pill--soft reveal'>Provetravanje posle pranja</li>
        </ul>
        <h3>Zidovi i podovi ostaju netaknuti</h3>
        <p class='body' style='margin-top:0'>Pranje radimo pažljivo, pa se zidovi i okolni podovi ne oštećuju.</p>
      </div>
    </div>
  </section>

  <section class='section section--tint' id='lokacije'>
    <div class='section__head reveal'>
      <h2>Pranje itisona Beograd: Novi Beograd, Zemun, Voždovac</h2>
      <p>Dolazimo na Vašu adresu u svim beogradskim opštinama, a dolazak je besplatan ako pranje vredi više od 1000 din.</p>
    </div>
    <div class='subs' data-stagger>
      <article class='sub reveal'><h3>Pranje itisona Novi Beograd</h3><p>Perimo itison u stanovima, kancelarijama i poslovnim prostorima na Novom Beogradu. Mašine donosimo na Vašu adresu.</p></article>
      <article class='sub reveal'><h3>Pranje itisona Zemun</h3><p>U Zemunu koristimo istu opremu i isti postupak u tri faze: naprskavanje, četkanje i usisavanje.</p></article>
      <article class='sub reveal'><h3>Pranje itisona Voždovac</h3><p>Pozovite, opišite prostor i dogovorite termin koji Vam odgovara. Tehničar dolazi sa mašinama na Vašu adresu.</p></article>
      <article class='sub reveal'><h3>Beograd i okolina</h3><p>Pored Beograda, itison perimo u Pančevu, Novom Sadu, Zrenjaninu, Smederevu i Požarevcu.</p></article>
    </div>
    <ul class='chips reveal' style='max-width:var(--max);margin:2rem auto 0'>
      <li class='pill pill--line'>Novi Beograd</li>
      <li class='pill pill--line'>Zemun</li>
      <li class='pill pill--line'>Voždovac</li>
      <li class='pill pill--line'>Pančevo</li>
      <li class='pill pill--line'>Novi Sad</li>
      <li class='pill pill--line'>Zrenjanin</li>
      <li class='pill pill--line'>Smederevo</li>
      <li class='pill pill--line'>Požarevac</li>
    </ul>
  </section>

  <section class='section' id='iskustvo'>
    <div class='split'>
      <div class='reveal'>
        <h2>Zašto klijenti biraju nas</h2>
        <p class='body'>
          Tokom 15 godina poslovanja naše usluge je koristilo preko 30.000 klijenata. Iskustvo nam omogućava da unapred prepoznamo koja površina traži pažljiviji tretman, a kojoj je potrebno više prolaza mašine.
        </p>
        <p class='body'>
          Koristimo najsavremenije profesionalne Karcher mašine i sredstva bez dugotrajnog mirisa. Prihvatamo sve eventualne reklamacije i ne obećavamo ono što ne možemo da ispunimo, zato Vas o težim flekama obaveštavamo pre početka rada.
        </p>
        <div class='actions'>
          <a class='pill pill--solid pill--lg' href='tel:0652389201'>Pozovite 065 238 9201</a>
        </div>
      </div>
      <div class='split__side reveal'>
        <h3>Na čemu smo radili</h3>
        <ul class='chips' data-stagger>
          <li class='pill pill--line reveal'>Stanovi i kuće</li>
          <li class='pill pill--line reveal'>Hoteli</li>
          <li class='pill pill--line reveal'>Igraonice</li>
          <li class='pill pill--line reveal'>Kancelarije</li>
        </ul>
        <h3>Naše ostale usluge</h3>
        <ul class='links'>
          <li><a href='/dubinsko-pranje-tepiha'>Dubinsko pranje tepiha</a><span>250 din./m²</span></li>
          <li><a href='/dubinsko-pranje-namestaja'>Dubinsko pranje nameštaja</a><span>trosed 2000 din.</span></li>
          <li><a href='/'>Dubinsko pranje Beograd: sve usluge</a><span>tepih, nameštaj, auto</span></li>
        </ul>
      </div>
    </div>
  </section>

  <Faq faq={faq} />
  <Footer />
</Layout>