---
import '@fontsource-variable/playfair-display/wght.css';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '../styles/global.css';
import Header from '../components/navbars/Header.astro';

interface Props {
  title: string;
  metaDescription?: string;
  ogTitle?: string;
  canonical?: string;
}

const { title, metaDescription, ogTitle, canonical } = Astro.props;
---

<!doctype html>
<html lang='sr'>
  <head>
    <title>{title}</title>

    <!-- META -->
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <meta name='title' content={title} />
    <meta name='description' content={metaDescription} />

    <meta property='og:url' content={canonical} />

    <!-- OG -->
    <meta property='og:site_name' content='' />
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:image' content='https://dubinskopranjebeograd.netlify.app/og-img.jpg' />
    <meta property='og:image' content='https://dubinskopranjebeograd.netlify.app/og-img.jpg' />
    <meta property='og:title' content={ogTitle} />
    <meta property='og:description' content={metaDescription} />
    <meta property='og:image:width' content='1200' />
    <meta property='og:image:height' content='630' />
    <meta property='og:type' content='website' />

    <!-- FAVICON -->
    <link rel='icon' type='image/png' href='/favicon/favicon-96x96.png' sizes='96x96' />
    <link rel='icon' type='image/svg+xml' href='/favicon/favicon.svg' />
    <link rel='shortcut icon' href='/favicon/favicon.ico' />
    <link rel='apple-touch-icon' sizes='180x180' href='/favicon/apple-touch-icon.png' />
    <meta name='apple-mobile-web-app-title' content='' />

    <link rel='canonical' href={canonical} />

  </head>
  <body>
    <main>
      <Header />
      <slot />
    </main>
  </body>
</html>

<style is:global>
    @font-face {
    font-family: 'Inter';
    font-weight: 100 900;
    font-style: oblique 0deg 10deg;
    src:
      url('/fonts/Inter/InterVariable.woff2') format('woff2 supports variations'),
      url('/fonts/Inter/InterVariable.woff2') format('woff2-variations'),
      url('/fonts/Inter/InterVariable.woff2') format('woff2');
  }

:root {
  --primary: #184d91;
  --ink: #15375d;
  --foreground: #183552;
  --teal: #287daf;
  --muted: #55687b;
  --line: #dbe5ef;
  --pale: #f1f7fc;
  --background: #fff;


  --accent: #2a86e0;        
  --card: #f5faff;
  --card-line: #d7e6f1;
  --shadow: 0 12px 30px #173e6810;

  --bg: var(--background);
  --bg-2: #eaf4fc;
  --blue: var(--accent);
  --blue-d: var(--primary);
  --blue-soft: white;

  --r: 1rem;
  --sans: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  --serif: 'Playfair Display Variable', Georgia, serif;
  --ease: cubic-bezier(0.22, 1, 0.36, 1);
  --pad: clamp(1rem, 5vw, 4rem);
  --max: 72rem;
  font-feature-settings: 'liga' 1, 'calt' 1;
  scroll-behavior: smooth;
}
</style>

<script>
  import '../scripts/page-effects';
</script>